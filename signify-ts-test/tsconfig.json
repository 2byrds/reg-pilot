{
  "include": ["src/**/*", "types", "test/**/*"],
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "node16",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    },
    "moduleResolution": "node16"
  }
}
